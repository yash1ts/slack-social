{
  "name": "slack-social",
  "version": "0.1.0",
  "private": true,
  "description": "Index public Slack activity into a local Instagram-style feed",
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.3.11",
  "bin": {
    "slack-social": "./packages/cli/src/index.ts"
  },
  "scripts": {
    "auth": "bun run --filter @slack-social/cli auth",
    "sync": "bun run --filter @slack-social/cli sync",
    "serve": "bun run --filter @slack-social/cli serve",
    "dev:web": "bun run --filter @slack-social/web dev",
    "build": "bun run --filter @slack-social/cli build && bun run --filter @slack-social/web build",
    "release:cli": "bash scripts/release-cli.sh",
    "slack-social": "bun packages/cli/src/index.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
